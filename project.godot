config_version=5

[application]

config/name="godot-project-maker"
run/main_scene="uid://v8hhfjgxiu7r"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PopupHandler="*uid://fabdss46w3dm"

[display]

window/subwindows/embed_subwindows=false

[dotnet]

project/assembly_name="godot-project-maker"

[file_customization]

